datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Partner {
  id                  Int         @id @default(autoincrement())
  name                String
  login               String      @unique
  password            String
  phone               String?
  email               String?     @unique
  emailVerified       Boolean     @default(false) // Подтверждён кодом на email
  address             String?
  isVip               Boolean     @default(false) // Доступ к запросу на реализацию
  role                PartnerRole @default(PARTNER)
  telegramChatId      String? // Личный чат ТГ для уведомлений о заказах (для обычных админов)
  showAdminPanelTitle Boolean     @default(true) // Показывать крупный заголовок "Админ панель" (можно скрыть в настройках профиля, чтобы освободить место на экране)
  createdAt           DateTime    @default(now())

  prices          Price[]
  orders          Order[]
  createdOrders   Order[]          @relation("OrderCreatedBy")
  orderChangeLogs OrderChangeLog[] @relation("OrderChangeLogChangedBy")
  realizations    Realization[]
  sessions        PartnerSession[]
}

model Product {
  id       Int         @id @default(autoincrement())
  type     ProductType
  number   String      @unique
  country  String
  image    String
  groupId  Int? // Товар без группы скрыт с публичного каталога (см. страницы /magnets, /plates и т.д.) и не может получить цену - себестоимость и цены живут на группе (ProductGroup.costPrice, Price)
  isHidden Boolean     @default(false) // Скрыт с публичного сайта, но остаётся в админке

  group            ProductGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  realizationItems RealizationItem[]

  @@index([type])
  @@index([groupId])
}

// Группы товаров - гибкая система группировки. Себестоимость общая для всей
// группы (например, все мраморные магниты стоят одинаково в производстве).
model ProductGroup {
  id           Int         @id @default(autoincrement())
  slug         String // WOOD, MARBLE, GLASS, etc.
  translations Json // {"en": "Wood", "ro": "Lemn", "ru": "Дерево"}
  type         ProductType // К какому типу товара относится группа
  costPrice    Decimal     @default(0) @db.Decimal(10, 2) // Себестоимость товаров этой группы
  createdAt    DateTime    @default(now())

  products      Product[]
  prices        Price[]
  defaultPrices DefaultPrice[]

  @@index([type])
  @@index([slug, type])
}

// Цены по умолчанию, применяемые новым партнёрам при создании
model DefaultPrice {
  id      Int         @id @default(autoincrement())
  type    ProductType
  groupId Int // Группа обязательна - товаров без группы больше не бывает
  price   Decimal     @db.Decimal(10, 2)

  group ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([type, groupId])
}

model Price {
  id        Int         @id @default(autoincrement())
  partnerId Int
  type      ProductType
  groupId   Int // Группа обязательна - товаров без группы больше не бывает
  price     Decimal     @db.Decimal(10, 2)

  partner Partner      @relation(fields: [partnerId], references: [id])
  group   ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([partnerId, type, groupId]) // У одного партнёра только одна цена на каждую комбинацию
}

model Order {
  id            Int         @id @default(autoincrement())
  partnerId     Int
  totalPrice    Decimal     @db.Decimal(12, 2) // Итоговая сумма к оплате (включает НДС, если hasVat)
  hasVat        Boolean     @default(false) // Заказ оформлен с НДС: к каждой позиции добавлено 20%
  vatAmount     Decimal     @default(0) @db.Decimal(12, 2) // Сумма НДС, включённая в totalPrice (не учитывается в анализе чистой прибыли)
  status        OrderStatus @default(NEW)
  isRealization Boolean     @default(false) // Флаг заказа на реализацию
  isMerged      Boolean     @default(false) // Заказ получен объединением нескольких заказов
  notes         String?     @db.Text // Примечание к заказу
  address       String?     @db.Text // Адрес доставки/самовывоза для заказа
  customPrices  Json? // Кастомные цены для конкретного заказа: {"MAGNET-1": 15, "PLATE-null": 20}
  createdById   Int? // Кто фактически оформил заказ - сам партнёр или админ от его имени (null - неизвестно/старые заказы)
  createdAt     DateTime    @default(now())
  deletedAt     DateTime? // Мягкое удаление: заказ лежит в "Корзине" и через 7 дней удаляется окончательно (см. /api/cron/purge-trash)

  partner     Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdBy   Partner?         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items       OrderItem[]
  realization Realization?
  changeLogs  OrderChangeLog[]

  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
  @@index([partnerId, status])
  @@index([deletedAt])
}

// История изменений позиций заказа (кто добавил/удалил/изменил количество)
model OrderChangeLog {
  id          Int      @id @default(autoincrement())
  orderId     Int
  changedById Int? // null, если аккаунт изменившего был позже удалён
  summary     String   @db.Text // краткое описание изменения для отображения
  details     Json // {added:[...], removed:[...], changed:[...]}
  createdAt   DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy Partner? @relation("OrderChangeLogChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  productId    Int
  quantity     Int
  pricePerItem Decimal @db.Decimal(10, 2) // Цена за единицу без НДС
  sum          Decimal @db.Decimal(12, 2) // Сумма позиции без НДС (используется в анализе прибыли)
  vatAmount    Decimal @default(0) @db.Decimal(12, 2) // НДС по позиции (20% от sum, если у заказа hasVat)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// Реализация товаров - товары отгруженные с условием «Реализация»
model Realization {
  id         Int               @id @default(autoincrement())
  orderId    Int               @unique
  partnerId  Int
  totalCost  Decimal           @db.Decimal(12, 2) // Общая стоимость товаров
  paidAmount Decimal           @default(0) @db.Decimal(12, 2) // Сколько дилер уже заплатил
  status     RealizationStatus @default(PENDING) // PENDING, PARTIAL, COMPLETED, CANCELLED
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  order    Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner  Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  items    RealizationItem[]
  payments RealizationPayment[]

  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
}

// Товары в реализации
model RealizationItem {
  id            Int     @id @default(autoincrement())
  realizationId Int
  productId     Int
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2) // Цена продажи за единицу
  costPrice     Decimal @db.Decimal(10, 2) // Себестоимость
  totalPrice    Decimal @db.Decimal(12, 2) // quantity * unitPrice

  realization Realization @relation(fields: [realizationId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([realizationId])
  @@index([productId])
}

// Платежи по реализации
model RealizationPayment {
  id            Int      @id @default(autoincrement())
  realizationId Int
  amount        Decimal  @db.Decimal(12, 2)
  notes         String?  @db.Text // Примечание к платежу
  paymentDate   DateTime @default(now()) // Дата внесения платежа
  createdAt     DateTime @default(now())

  realization Realization @relation(fields: [realizationId], references: [id], onDelete: Cascade)
}

// Заявки на партнерство
model PartnershipRequest {
  id        Int           @id @default(autoincrement())
  phone     String
  email     String?
  address   String?
  login     String
  password  String
  message   String?       @db.Text
  ipAddress String? // IP адрес для защиты от спама
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([ipAddress, createdAt]) // Индекс для проверки лимита заявок
}

// Одноразовые коды подтверждения email (отправляются через Nodemailer)
model EmailVerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PartnerSession {
  id         Int       @id @default(autoincrement())
  partnerId  Int
  tokenHash  String    @unique
  bindHash   String    @unique
  userAgent  String?
  label      String? // Название сессии от пользователя, напр. "Из дома", "Из цеха"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([expiresAt])
}

enum PartnerRole {
  SUPER_ADMIN // Полный доступ ко всей админ-панели, единственный
  ADMIN // Ограниченный админ: только страница "Заказы" (просмотр, создание, экспорт)
  PRODUCT_ADMIN // Ограниченный админ: только товары и группы (CRUD каталога)
  PARTNER
}

enum ProductType {
  MAGNET
  PLATE
  POSTCARD
  KEYCHAIN
  STATUE
  BALL
}

enum OrderStatus {
  NEW // Новый заказ, ожидает подтверждения
  CONFIRMED // Подтверждён админом
  SHIPPED // Отправлен партнёру
  PAID // Оплачен (учитывается в доходе)
  CANCELLED // Отменён
}

enum RealizationStatus {
  PENDING // Ожидает платежа
  PARTIAL // Частичный платёж получен
  COMPLETED // Полностью оплачена
  CANCELLED // Отменена
}

enum RequestStatus {
  PENDING // Ожидает рассмотрения
  APPROVED // Одобрена (партнер создан)
  REJECTED // Отклонена
}
